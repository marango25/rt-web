// secrets.h.example — copia este archivo a secrets.h y pon tus datos reales.
// secrets.h está en .gitignore, así que tus credenciales nunca se suben al repo.
//
// AP_SSID/AP_PASS son la red WiFi que el PROPIO ESP8266 va a transmitir (modo
// Access Point) - no es tu WiFi de casa. AP_PASS necesita mínimo 8 caracteres
// (si pones menos, el ESP8266 cae a una red abierta sin contraseña).
#define AP_SSID "RT-Web"
#define AP_PASS "cambia_esto"
